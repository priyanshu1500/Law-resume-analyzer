# --- Supabase (auth + saved responses) -----------------------------
# Project Settings -> API. Leave unset to keep the login gate disabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser. Used by the payment webhook.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (payments — added in the paywall build) --------------
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Resume retention cron (Phase 5) --------------------------------
# Shared secret checked by /api/cron/cleanup-resumes against the
# Authorization header Vercel Cron sends. Generate with `openssl rand -hex 32`.
CRON_SECRET=
